{{!
    @template mod_mootimeter/main

    Mount point of the mootimeter React application.

    Context variables required for this template:
    * props JSON encoded props of the application, see mod_mootimeter/lib/types AppProps

    Example context (json):
    {
        "props": "{\"cmid\": 1, \"pageid\": 0, \"view\": \"question\"}"
    }
}}
{{#react}}
{
    "component": "@moodle/lms/mod_mootimeter/app",
    "props": {{{props}}},
    "class": "mod_mootimeter-app"
}
<div class="mootimeter-render-loading">{{> core/loading }} {{#str}} loading, mod_mootimeter {{/str}}</div>
{{/react}}
